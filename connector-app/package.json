{
  "name": "officebridge-connector-app",
  "version": "0.1.0",
  "private": true,
  "description": "OfficeBridge Connector — login-gated desktop app. The outbound tunnel only runs while an admin is authenticated.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . \"OfficeBridge Connector\" --platform=darwin --arch=arm64 --out=dist --overwrite --asar=false --icon=assets/icon.icns",
    "package:win": "electron-packager . \"OfficeBridge Connector\" --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --icon=assets/icon.ico"
  },
  "dependencies": {
    "electron": "^32.0.0",
    "menubar": "^9.5.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron-packager": "^17.1.2"
  }
}
