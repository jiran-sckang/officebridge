node_modules/
run/
*.log
certs/*.pem
.DS_Store
build/

# Live server state — real per-deployment data, not code. Never track this:
# a code deploy (git archive/clone) must never able to clobber a running
# server's actual users/policy/tokens. data/seed/ is the only data/ subtree
# that IS code (the clean-bootstrap template for a brand-new deployment).
/data/*.json
/data/audit.log

# Same reasoning, same incident category: each deployment's own domain/
# tenant name is not code either. config.example.js is the tracked
# template — copy it to config.js once per deployment and never again.
/relay/config.js
